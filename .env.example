# ─────────────────────────────────────────────────────────────────────────────
# COGENT bi — Trial Activation Dashboard
# Environment variables
#
# Copy this file to .env and fill in your Snowflake credentials.
# The .env file is used ONLY by the export script (scripts/export_data.py).
# The dashboard API itself reads from data/dashboard/*.json at runtime.
#
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# Snowflake connection (used by scripts/export_data.py to refresh dashboard data)
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=your-warehouse
SNOWFLAKE_DATABASE=your-database
SNOWFLAKE_SCHEMA=DBT_DEV_MARTS

# API server (optional overrides — defaults shown)
API_HOST=127.0.0.1
API_PORT=8000
